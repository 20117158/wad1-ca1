{{#if singleSpecies.animals}}

  <table class="ui unstackable striped table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Favorite Food</th>
        <th>Image</th>
        <th></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each singleSpecies.animals}}
        {{> listOneAnimal animalId=../singleSpecies.id}}
        {{> editanimal animalId=../singleSpecies.id}}
      {{/each}}
    </tbody>
  </table>

  {{#each singleSpecies.animals}}
    <script>
      document.querySelector("#showEdit{{@index}}").addEventListener('click', () => {
        document.querySelector("#animal{{@index}}").style.display = "none";
        document.querySelector("#edit{{@index}}").style.display = "table-row";
      })
      document.querySelector("#hideEdit{{@index}}").addEventListener('click', () => {
        document.querySelector("#animal{{@index}}").style.display = "table-row";
        document.querySelector("#edit{{@index}}").style.display = "none";
      })
    </script>
  {{/each}}

{{else}}
  <h3 class="ui message">
    No animals in this group!
  </h3>

{{/if}}