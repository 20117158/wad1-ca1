
{{#if singleSpecies.animals}}

  <table class="ui unstackable striped table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Favorite Food</th>
        <th>Image</th>
      </tr>
    </thead>
    <tbody>
      {{#each singleSpecies.animals}}
        <tr>
          <td>
            {{name}}
          </td>
          <td>
            {{age}}
          </td>
          <td>
            {{favoriteFood}}
          </td>
          <td>
            <img src={{image}} width="120">
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

{{else}}
  <h3 class="ui message">
    No animals in this group!
  </h3>

{{/if}}
