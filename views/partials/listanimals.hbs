
{{#if singleSpecies.animals}}

  <table class="ui unstackable striped table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Favorite Food</th>
        <th>Image</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
{{#each singleSpecies.animals}}
  {{> listOneAnimal animalId=../id}}
{{/each}}
    </tbody>
  </table>

{{else}}
  <h3 class="ui message">
    No animals in this group!
  </h3>

{{/if}}
