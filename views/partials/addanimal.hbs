<form class="ui stacked segment form" action="/animals/{{species.id}}/addanimal" method="POST" enctype="multipart/form-data">
  <div class="three fields">
    <div class="field">
      <label>Name</label>
      <input type="text" name="name" autofocus required
        title="Please include a valid Name"
        placeholder="Name">
    </div>
    <div class="field">
      <label>Age</label>
      <input type="number" name="age" required
        title="Please include a valid Age"
        placeholder="Age">
    </div>
    <div class="field">
      <label>Favorite Food</label>
      <input type="text" name="favoriteFood" required
        title="Please include a valid Food"
        placeholder="Favorite Food">
    </div>
  </div>
  <div class="fields">
    <div class="field">
      <label>Image</label>
      <input type="file" name="image" required>
    </div>
  </div>
  <button class="ui blue submit button">Add Animal</button>
</form>