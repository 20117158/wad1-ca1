<section class="ui left aligned middle aligned segment">

  {{> dashboardheader}}

  {{#unless search}}
    {{#unless animalCollection}}
      <h3 class="ui message">
        Start adding your animal groups!
      </h3>
    {{/unless}}
  {{/unless}}

  <div class="ui centered link cards">
    {{#each animalCollection}}
      <div class="ui card">
        <div class="image">
          <img src="{{image.url}}">
        </div>
        <div class="content">
          <a class="header">{{species}}</a>
          <p>
            <i class="paw icon"></i>
            {{#if animals}}
              Total animals: {{animals.length}}
            {{else}}
              No animals in this group!
            {{/if}}
          </p>
        </div>
        <div class="extra content">
          <a href="/animals/{{id}}">
            <i class="ui open folder outline black icon"></i>
          </a>
          <a href="/dashboard/deletespecies/{{id}}">
            <i class="ui black trash icon"></i>
          </a>
        </div>
      </div>
    {{/each}}
  </div>

</section>