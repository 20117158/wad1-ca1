<tr id="animal{{@index}}">
  <td>{{name}}</td>
  <td>{{age}}</td>
  <td>{{favoriteFood}}</td>
  <td><img src={{image}} width="120"></td>
  <td class="center aligned">
    <a href="/animals/{{animalId}}/deleteanimal/{{id}}"
       title="Delete animal">
      <i class="ui black trash icon"></i>
    </a>
  </td>
</tr>