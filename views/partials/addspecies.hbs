<form class="ui stacked segment form" action="/dashboard/addspecies" method="POST" enctype="multipart/form-data">
  <div class="two fields">
    <div class="field">
      <label>Species</label>
      <input placeholder="Species" type="text" name="species" autofocus required>
    </div>
    <div class="field">
      <label>Image</label>
      <input placeholder="Image" type="file" name="image" required>
    </div>
  </div>
  <button class="ui blue submit button">Add Species</button>
</form>